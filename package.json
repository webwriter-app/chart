{
  "name": "@webwriter/chart",
  "version": "1.2.3",
  "description": "ww-chart is an interactive data visualization widget for the WebWriter tool that implements various charts and diagrams for static and exploratory data visualization.",
  "keywords": [
    "webwriter-widget"
  ],
  "license": "MIT",
  "author": "Phuong Anh Nguyen",
  "repository": {
    "url": "https://git.rwth-aachen.de/learntech-lufgi9/bama/webwriter/ww-chart",
    "type": "git"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build && ./create-files.sh",
    "check-prettier": "npx prettier --check .",
    "run-prettier": "npx prettier --write .",
    "coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit --composite false"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.15.1",
    "@types/d3": "^7.4.3",
    "@webwriter/lit": "^2.0.0",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.2",
    "d3": "^7.9.0",
    "d3-regression": "^1.3.10",
    "lit": "^3.1.4",
    "random-words": "^1.3.0",
    "wwc-cli": "^1.0.16"
  },
  "devDependencies": {
    "@vitest/coverage-c8": "^0.30.1",
    "prettier": "^2.8.7",
    "typescript": "^4.9.3",
    "vite": "^4.2.0",
    "vite-plugin-babel": "^1.1.3",
    "vitest": "^0.30.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./widgets/webwriter-chart.*": {
      "source": "./src/widget.ts",
      "default": "./dist/widgets.*"
    },
    "./snippets/info-sheet": "./src/snippets/info-sheet.html",
    "./snippets/example-exercise": "./src/snippets/example-exercise.html"
  },
  "editingConfig": {
    "./widgets/webwriter-chart": {
      "label": {
        "en": "Charts"
      }
    },
    "./snippets/info-sheet": {
      "label": {
        "en": "Scatterplot Info Sheet"
      }
    },
    "./snippets/example-exercise": {
      "label": {
        "en": "Example Exercise"
      }
    }
  }
}
