{
    "name": "@webwriter/chart",
    "version": "1.2.17",
    "description": "ww-chart is an interactive data visualization widget for the WebWriter tool that implements various charts and diagrams for static and exploratory data visualization.",
    "keywords": [
        "webwriter-widget"
    ],
    "license": "MIT",
    "author": "Phuong Anh Nguyen",
    "repository": {
        "url": "https://git.rwth-aachen.de/learntech-lufgi9/bama/webwriter/ww-chart",
        "type": "git"
    },
    "scripts": {
        "build": "npx @webwriter/build",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npx @webwriter/build",
        "dev": "npx @webwriter/build dev",
        "localize": "lit-localize extract && npx @webwriter/build localize && lit-localize build"
    },
    "dependencies": {
        "@shoelace-style/shoelace": "^2.15.1",
        "@tabler/icons": "^3.40.0",
        "@types/d3": "^7.4.3",
        "@webwriter/lit": "^2.0.0",
        "bootstrap-icons": "^1.11.3",
        "chart.js": "^4.4.2",
        "d3": "^7.9.0",
        "d3-regression": "^1.3.10",
        "lit": "^3.1.4",
        "random-words": "^1.3.0",
        "wwc-cli": "^1.0.16",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "typescript": "^5.6.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        "./widgets/webwriter-chart.*": {
            "source": "./src/widget/webwriter-chart.ts",
            "default": "./dist/widgets.*"
        },
        "./snippets/scatterplot-exercise.html": "./src/snippets/scatterplot-exercise.html",
        "./snippets/mean-median-exercise.html": "./src/snippets/mean-median-exercise.html",
        "./icon": "./chart-dots-2.svg"
    },
    "editingConfig": {
        "./widgets/webwriter-chart": {
            "label": {
                "en": "Charts"
            }
        },
        "./snippets/scatterplot-exercise.html": {
            "label": {
                "en": "Scatterplot-Exercise"
            }
        },
        "./snippets/mean-median-exercise.html": {
            "label": {
                "en": "Mean-Median-Exercise"
            }
        }
    }
}