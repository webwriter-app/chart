{
  "name": "ww-chart",
  "version": "0.0.0",
  "description": "ww-chart is an interactive data visualization widget for the WebWriter tool that implements various charts and diagrams for static and exploratory data visualization.",
  "author": "Luis Kugel",
  "license": "UNLICENSED",
  "main": "dist/widget.es.js",
  "exports": {
    ".": "./dist/widget.es.js"
  },
  "types": "types/wighet.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "keywords": [
    "data-visualization",
    "charts",
    "diagrams",
    "WebWriter",
    "webwriter-widget"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build",
    "check-prettier": "npx prettier --check .",
    "run-prettier": "npx prettier --write .",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@git.rwth-aachen.de:learntech-lufgi9/bama/webwriter/ww-chart.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lit": "^2.6.1"
  },
  "devDependencies": {
    "@vitest/coverage-c8": "^0.30.1",
    "prettier": "^2.8.7",
    "typescript": "^4.9.3",
    "vite": "^4.2.0",
    "vitest": "^0.30.1"
  }
}
