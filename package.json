{
  "name": "@luiskugel/ww-chart",
  "version": "1.0.0",
  "description": "ww-chart is an interactive data visualization widget for the WebWriter tool that implements various charts and diagrams for static and exploratory data visualization.",
  "author": "Luis Kugel",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/widget.js",
  "exports": {
    ".": "./dist/widget.js"
  },
  "files": [
    "dist",
    "types"
  ],
  "keywords": [
    "data-visualization",
    "charts",
    "diagrams",
    "WebWriter",
    "webwriter-widget"
  ],
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build && ./create-files.sh",
    "check-prettier": "npx prettier --check .",
    "run-prettier": "npx prettier --write .",
    "coverage": "vitest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@git.rwth-aachen.de:learntech-lufgi9/bama/webwriter/ww-chart.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.4.0",
    "@webwriter/lit": "^0.4.1",
    "chart.js": "^4.2.1",
    "lit": "^2.6.1",
    "lit-sm": "^1.0.2",
    "random-words": "^1.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-c8": "^0.30.1",
    "prettier": "^2.8.7",
    "typescript": "^4.9.3",
    "vite": "^4.2.0",
    "vite-plugin-babel": "^1.1.3",
    "vitest": "^0.30.1"
  }
}
